[Unit]
Description=Paperless-ngx Gotenberg (office-document → PDF conversion)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/gotenberg/gotenberg:8.25
AutoUpdate=registry

# Hardening flags taken verbatim from the upstream Paperless-ngx compose.
Exec=gotenberg --chromium-disable-javascript=true --chromium-allow-list=file:///tmp/.*

Network=paperless.network

# Stateless — no volumes, no published ports (reached in-network as
# systemd-paperless-gotenberg:3000).

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
