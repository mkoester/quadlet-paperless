# Non-sensitive defaults for Paperless-ngx. Secrets/instance values live in
# paperless.override.env (created from the template; gitignored).

# --- Service discovery (peers reached by their default quadlet name) ---
PAPERLESS_REDIS=redis://systemd-paperless-broker:6379
PAPERLESS_DBHOST=systemd-paperless-db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless

# --- Office-document handling (Gotenberg + Tika) ---
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://systemd-paperless-gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://systemd-paperless-tika:9998

# --- Locale / OCR (adjust to your documents) ---
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_OCR_LANGUAGES=eng
PAPERLESS_TIME_ZONE=Europe/Berlin

# --- PostgreSQL container init vars (used by paperless-db on first run) ---
POSTGRES_DB=paperless
POSTGRES_USER=paperless
