# Local overrides — values here take precedence over paperless.env.
# Copy to paperless.override.env (gitignored) and fill in.

# Required: PostgreSQL password. The SAME value must be set for both the DB
# container (POSTGRES_PASSWORD) and the Paperless app (PAPERLESS_DBPASS).
#POSTGRES_PASSWORD=changeme
#PAPERLESS_DBPASS=changeme

# Required: Django secret key — a long random string.
# Generate one with: openssl rand -base64 48
#PAPERLESS_SECRET_KEY=changeme

# Required when exposed on a public domain (CSRF / absolute URLs).
#PAPERLESS_URL=https://paperless.example.com

# Optional: bootstrap a superuser on the FIRST run of an EMPTY database.
# NOT needed when migrating — the restored dump already contains your users.
#PAPERLESS_ADMIN_USER=admin
#PAPERLESS_ADMIN_PASSWORD=changeme
