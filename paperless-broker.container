[Unit]
Description=Paperless-ngx broker (Redis)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/redis:8
AutoUpdate=registry

# redis user in the redis image runs as UID 999
# Verify: podman inspect docker.io/library/redis:8 --format '{{.Config.User}}'
UserNS=keep-id:uid=999,gid=999
User=999
Group=999

Network=paperless.network

# Redis persistence (Paperless task queue / cache)
Volume=%h/redis:/data:Z

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
