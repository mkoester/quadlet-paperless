# Credentials for taxonomy-audit.py. Copy to taxonomy-audit.env (gitignored) and fill in.
# Real environment variables of the same name override anything set here.

# --- Paperless-ngx REST API ---
# Base URL of your Paperless-ngx instance (the Caddy URL is fine). A trailing /api is
# tolerated (auto-stripped), so both https://host and https://host/api/ work.
PAPERLESS_URL=https://paperless.example.tld
# API token: Paperless-ngx → Settings → create token (used as "Authorization: Token <token>").
# Use a SUPERUSER's token — tokens are per-user and only return objects that user can see.
PAPERLESS_TOKEN=changeme

# --- Ollama backend (only needed unless you run with --no-llm) ---
# Ollama host — must be reachable from WHEREVER YOU RUN THIS SCRIPT. A link-local/private
# address (e.g. 169.254.x.x) that works for the server-side paperless-ai-next container may
# NOT route from your workstation; use the GPU box's LAN IP/hostname, or run this on the server.
OLLAMA_HOST=http://gpu-box.lan:11434
# Model to use. gemma4-paperless (defined in quadlet-paperless-ai-next) already bakes in a
# large context; any 7B–14B instruct model works for this taxonomy-analysis task.
OLLAMA_MODEL=gemma4-paperless
# Optional: only if your Ollama endpoint sits behind an auth proxy expecting a bearer token.
# Native Ollama has no auth and ignores this. (A timeout is a network problem, not auth.)
#OLLAMA_API_KEY=changeme

# --- Optional tuning ---
# Context window passed to Ollama's native /api/generate (num_ctx option — this endpoint
# honors it, unlike the OpenAI-compatible one). Raise if a taxonomy is large; higher =
# more VRAM. Tags (~800), document types (~270), and correspondents each fit in 16384.
#OLLAMA_NUM_CTX=16384
# Sampling temperature for the model (default 0.2). Low = conservative/repeatable merge
# plans; raise only if you want the model to propose more (riskier) consolidations.
#OLLAMA_TEMPERATURE=0.2
# Items with <= this many documents are flagged as low-use merge/delete candidates.
#SINGLETON_THRESHOLD=2
